{
  "name": "pleiad",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pleiad: a personal spaced-repetition learning app (PWA).",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "budget": "node scripts/check-budget.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "node scripts/validate-content.ts",
    "prebuild": "node scripts/build-content-index.ts",
    "content:index": "node scripts/build-content-index.ts",
    "content:register": "node scripts/register-ids.ts",
    "predev": "node scripts/build-content-index.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "preact": "11.2.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-window": "7.4.1"
  }
}
