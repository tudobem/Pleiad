{
  // src/core must stay pure TypeScript: no DOM lib and no ambient types,
  // so any browser or Node API used there fails the typecheck.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.core.tsbuildinfo"
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["src/core/**/*.test.ts"]
}
