{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question (SPEC 5.4 and 6)",
  "type": "object",
  "required": [
    "id",
    "pack",
    "topic",
    "type",
    "tier",
    "tags",
    "prompt",
    "explanation",
    "sources",
    "status",
    "created"
  ],
  "properties": {
    "id": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "pack": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "topic": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "type": {
      "enum": ["mcq", "recall", "short", "cloze", "match", "order", "estimation", "timeline"]
    },
    "tier": {
      "enum": ["foundational", "advanced", "expert"]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      }
    },
    "prompt": {
      "$ref": "defs.schema.json#/$defs/nonEmptyText"
    },
    "explanation": {
      "$ref": "defs.schema.json#/$defs/nonEmptyText"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation"],
        "properties": {
          "citation": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "url": {
            "$ref": "defs.schema.json#/$defs/url"
          }
        }
      }
    },
    "status": {
      "enum": ["draft", "verified", "retired"]
    },
    "created": {
      "$ref": "defs.schema.json#/$defs/isoDate"
    },
    "verified_on": {
      "$ref": "defs.schema.json#/$defs/isoDate"
    },
    "deeper": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "text": {
          "$ref": "defs.schema.json#/$defs/nonEmptyText"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              },
              "url": {
                "$ref": "defs.schema.json#/$defs/url"
              }
            }
          }
        },
        "furtherReading": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["src", "alt", "license"],
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^media/[A-Za-z0-9._/-]+$",
            "description": "Path relative to the pack folder."
          },
          "alt": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "credit": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "license": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText",
            "description": "Use the pack license for self-authored images."
          }
        }
      }
    },
    "confusable_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      }
    },
    "concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "defs.schema.json#/$defs/id"
      }
    },
    "lang": {
      "$ref": "defs.schema.json#/$defs/lang"
    },
    "answer": true,
    "answer_text": true,
    "answers": true,
    "bank": true,
    "items": true,
    "numeric": true,
    "options": true,
    "pairs": true,
    "text": true,
    "value": true,
    "unit": true,
    "scale": true,
    "bins": true,
    "range": true,
    "tolerance": true,
    "events": true,
    "precision": true
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "mcq",
      "properties": {
        "type": {
          "const": "mcq"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              },
              "why_wrong": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              }
            }
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "answer_text": false,
        "answers": false,
        "bank": false,
        "items": false,
        "numeric": false,
        "pairs": false,
        "text": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["options", "answer"]
    },
    {
      "title": "recall",
      "properties": {
        "type": {
          "const": "recall"
        },
        "answer_text": {
          "$ref": "defs.schema.json#/$defs/nonEmptyText"
        },
        "answer": false,
        "answers": false,
        "bank": false,
        "items": false,
        "numeric": false,
        "options": false,
        "pairs": false,
        "text": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["answer_text"]
    },
    {
      "title": "short",
      "properties": {
        "type": {
          "const": "short"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "description": "First is the canonical answer; the rest are accepted variants."
        },
        "numeric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "tolerance"],
          "properties": {
            "value": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          },
          "description": "Accept numbers within value \u00b1 tolerance."
        },
        "answer": false,
        "answer_text": false,
        "bank": false,
        "items": false,
        "options": false,
        "pairs": false,
        "text": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["answers"]
    },
    {
      "title": "cloze",
      "properties": {
        "type": {
          "const": "cloze"
        },
        "text": {
          "type": "string",
          "pattern": "\\{\\{[^{}]+\\}\\}",
          "description": "Sentence with blanks written as {{answer}}."
        },
        "bank": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "description": "Distractor chips shown together with the answers."
        },
        "answer": false,
        "answer_text": false,
        "answers": false,
        "items": false,
        "numeric": false,
        "options": false,
        "pairs": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["text"]
    },
    {
      "title": "match",
      "properties": {
        "type": {
          "const": "match"
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              },
              "right": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              }
            }
          }
        },
        "answer": false,
        "answer_text": false,
        "answers": false,
        "bank": false,
        "items": false,
        "numeric": false,
        "options": false,
        "text": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["pairs"]
    },
    {
      "title": "order",
      "properties": {
        "type": {
          "const": "order"
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "$ref": "defs.schema.json#/$defs/nonEmptyText"
          },
          "description": "Items in the correct order; shown shuffled."
        },
        "answer": false,
        "answer_text": false,
        "answers": false,
        "bank": false,
        "numeric": false,
        "options": false,
        "pairs": false,
        "text": false,
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "events": false,
        "precision": false
      },
      "required": ["items"]
    },
    {
      "title": "estimation",
      "properties": {
        "type": {
          "const": "estimation"
        },
        "value": {
          "type": "number",
          "description": "The true value."
        },
        "unit": {
          "$ref": "defs.schema.json#/$defs/nonEmptyText",
          "description": "Unit shown with numbers, e.g. \"neurons\". Leave out for years."
        },
        "scale": {
          "enum": ["linear", "log"]
        },
        "bins": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              }
            }
          },
          "description": "Ranges to tap, sorted; max is exclusive; exactly one contains value."
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "description": "Slider ends (when there are no bins)."
        },
        "tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Slider grading: a factor >= 1 on a log scale, an absolute amount on a linear one."
        },
        "events": false,
        "precision": false,
        "answer": false,
        "answer_text": false,
        "answers": false,
        "bank": false,
        "items": false,
        "numeric": false,
        "options": false,
        "pairs": false,
        "text": false
      },
      "required": ["value", "scale"],
      "oneOf": [
        {
          "required": ["bins"],
          "not": {
            "anyOf": [
              {
                "required": ["range"]
              },
              {
                "required": ["tolerance"]
              }
            ]
          }
        },
        {
          "required": ["range", "tolerance"],
          "not": {
            "required": ["bins"]
          }
        }
      ]
    },
    {
      "title": "timeline",
      "properties": {
        "type": {
          "const": "timeline"
        },
        "events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "date"],
            "properties": {
              "label": {
                "$ref": "defs.schema.json#/$defs/nonEmptyText"
              },
              "date": {
                "type": "string",
                "pattern": "^-?\\d{1,4}(-\\d{2}(-\\d{2})?)?$",
                "description": "YYYY, YYYY-MM or YYYY-MM-DD; a leading - for BCE years."
              }
            }
          },
          "description": "Events to put in date order; shown shuffled."
        },
        "precision": {
          "enum": ["year", "month", "day"]
        },
        "value": false,
        "unit": false,
        "scale": false,
        "bins": false,
        "range": false,
        "tolerance": false,
        "answer": false,
        "answer_text": false,
        "answers": false,
        "bank": false,
        "items": false,
        "numeric": false,
        "options": false,
        "pairs": false,
        "text": false
      },
      "required": ["events"]
    }
  ]
}
