{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pack metadata (pack.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "version",
    "language",
    "author",
    "license",
    "provenance",
    "created",
    "domainPath",
    "accent"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "defs.schema.json#/$defs/id" },
    "title": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
    "description": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the pack content."
    },
    "language": { "$ref": "defs.schema.json#/$defs/lang" },
    "author": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
    "license": {
      "$ref": "defs.schema.json#/$defs/nonEmptyText",
      "description": "SPDX identifier where possible, e.g. CC-BY-4.0."
    },
    "provenance": {
      "$ref": "defs.schema.json#/$defs/nonEmptyText",
      "description": "How the items were created and checked."
    },
    "created": { "$ref": "defs.schema.json#/$defs/isoDate" },
    "domainPath": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "defs.schema.json#/$defs/id" },
      "description": "Taxonomy node IDs from the root down to where this pack attaches."
    },
    "accent": {
      "$ref": "defs.schema.json#/$defs/id",
      "description": "Name of a color token in src/ui/tokens.css, without the leading dashes."
    }
  }
}
