{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept graph of a pack (concepts.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "$schema": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/id" },
          "label": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
          "summary": { "$ref": "defs.schema.json#/$defs/nonEmptyText" },
          "topic": { "$ref": "defs.schema.json#/$defs/id" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "$ref": "defs.schema.json#/$defs/id" },
          "to": { "$ref": "defs.schema.json#/$defs/id" },
          "relation": { "enum": ["prerequisite", "related", "contrasts_with", "part_of"] }
        }
      }
    }
  }
}
